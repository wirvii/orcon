#!/bin/sh
# SPDX-FileCopyrightText: The Orcon Authors
# SPDX-License-Identifier: Apache-2.0
#
# pre-push hook: lints the commit messages about to be pushed with commitlint
# (orcon-contributing CM-11, ADR 0081). Enable with `make hooks`.
# Git passes "<remote name> <remote url>" as arguments and one line per ref on
# standard input: <local ref> <local sha> <remote ref> <remote sha>.
set -eu

root=$(cd "$(dirname "$0")/../.." && pwd)
zero=0000000000000000000000000000000000000000

if [ ! -x "$root/node_modules/.bin/commitlint" ]; then
  echo "pre-push: commitlint not installed (run pnpm install); CI will check commit messages"
  exit 0
fi

cd "$root"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  : "$remote_ref"
  # Deleted refs and tags carry no commit messages to lint.
  [ "$local_sha" = "$zero" ] && continue
  case "$local_ref" in
    refs/tags/*) continue ;;
  esac
  if [ "$remote_sha" = "$zero" ]; then
    from=origin/main
  else
    from=$remote_sha
  fi
  if ! pnpm exec commitlint --from "$from" --to "$local_sha" --verbose; then
    echo "pre-push: reword the failing commits with git rebase -i $from" >&2
    status=1
  fi
done
exit "$status"
