{
  "name": "orcon",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "i18n:check": "turbo i18n:check",
    "licenses:check": "node packages/js/lint-config/scripts/check-licenses.mjs",
    "generate": "turbo run generate",
    "generate:check": "pnpm generate && git diff --exit-code -- apps/web/src/app/routeTree.gen.ts packages/js/api-contract/src"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "turbo": "^2.4.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ],
    "overrides": {
      "handlebars": "^4.7.10",
      "tinypool": "^2.1.2",
      "@ai-sdk/provider-utils": "^4.0.33"
    }
  }
}
