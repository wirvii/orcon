              "x-orcon-flag": "--http-tls-key-file",
              "x-orcon-reload": "restart",
              "x-orcon-roles": [
                "standalone",
                "api"
              ]
            }
          },
          "type": "object"
        },
        "trustedProxies": {
          "description": "Networks (CIDR) of the reverse proxies whose X-Forwarded-* headers are trusted. Empty trusts none.",
