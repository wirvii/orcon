              "x-orcon-secret-file-for": "backup.s3.secretAccessKey"
            },
            "serverSideEncryption": {
              "description": "Server-side encryption mode to request from the object store, for example aws:kms. Empty requests none.",
              "type": "string",
              "x-orcon-env": "ORCON_BACKUP_S3_SERVER_SIDE_ENCRYPTION",
              "x-orcon-flag": "--backup-s3-server-side-encryption",
