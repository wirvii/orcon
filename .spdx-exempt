#
# Files exempt from the SPDX header check (tools/spdxcheck). One glob per line,
# each with a reason: "glob  # reason". Binary files are skipped automatically.

# Tool-managed configuration directories and instruction files are exempt
# built in (tools/provenance/configpaths); they are not repeated here.

# Formats without comment syntax, or whose bytes are significant.
LICENSE  # canonical license text, must stay byte-identical
NOTICE  # third-party attribution notices, shipped verbatim with the binary
**/go.sum  # generated checksum list; comments are not allowed
**/package.json  # JSON has no comment syntax
turbo.json  # JSON has no comment syntax
pnpm-lock.yaml  # generated lock file
internal/adapter/webui/dist/**  # build output of the web app, replaced by make web
tools/licenses/exceptions.txt  # plain-text data file read by licensecheck (it carries the SPDX lines as comments)
tools/licenses/npm-exceptions.txt  # plain-text data file read by the web license check (it carries the SPDX lines as comments)

**/tsconfig*.json  # JSON has no comment syntax
packages/js/tokens/src/**/*.json  # design token sources in the W3C format; JSON has no comment syntax
packages/js/tokens/src/*.json  # design token sources in the W3C format; JSON has no comment syntax
packages/js/ui/scripts/inventory.json  # generated component inventory; JSON has no comment syntax
packages/js/ui/src/i18n/*.json  # translation catalogs; JSON has no comment syntax
internal/adapter/codec/flowjson/schema/*.json  # JSON Schema; the licence is stated in its $comment member
internal/flow/testdata/conformance/*.json  # conformance flows are pure JSON data read by tests
.agents/skills/orcon-connector/assets/templates/**/*.json  # connector template packages and cassettes; JSON has no comment syntax

# Contribution workflow (orcon-contributing, SPEC-013).
CODE_OF_CONDUCT.md                       # third-party text, Contributor Covenant 2.1, CC-BY-4.0, attribution inside
.github/pull_request_template.md         # copied into every pull request description
.agents/skills/orcon-contributing/assets/github-settings.expected.json   # JSON has no comment syntax
.agents/skills/orcon-contributing/assets/templates/commit-message.txt   # plain-text commit template (it carries the SPDX lines as comments)

# Plain-text declaration and checksum files read by tools/dbcheck and dbrules; they carry the SPDX lines as comments.
internal/adapter/storetest/dbrules/policy/*.txt  # policy declaration files (SPEC-009 4.4.7)
**/migrations.sum  # migration checksum list read by dbcheck (migrations.md MG-5)
tools/dbcheck/testdata/**/expect.txt  # planted-case expectation read by the dbcheck tests
internal/adapter/storetest/dbrules/testdata/**/expect.txt  # planted-case expectation read by the dbrules tests
