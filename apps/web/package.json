{
  "name": "@orcon/web",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint --allow-empty-input \"**/*.css\"",
    "test:a11y": "playwright test",
    "i18n:check": "node scripts/i18n.mjs check",
    "i18n:write": "node scripts/i18n.mjs write",
    "generate": "node scripts/generate-routes.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --coverage",
    "test:screens": "vitest run --project screens"
  },
  "dependencies": {
    "@hookform/resolvers": "^5",
    "@orcon/ui": "workspace:*",
    "@tanstack/react-query": "^5",
    "@tanstack/react-router": "^1",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7",
    "react-intl": "^7",
    "zod": "^4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@formatjs/cli": "^6.7.0",
    "@formatjs/icu-messageformat-parser": "^2.11.0",
    "@orcon/lint-config": "workspace:*",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/router-plugin": "^1",
    "@tanstack/virtual-file-routes": "^1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.20.0",
    "jsdom": "^26.1.0",
    "msw": "^2",
    "stylelint": "^16.15.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.0"
  }
}
