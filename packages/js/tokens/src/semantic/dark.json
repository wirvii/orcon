{
  "bg": {
    "$type": "color",
    "app": {
      "$value": "{color.navy.950}"
    }
  },
  "surface": {
    "$type": "color",
    "default": {
      "$value": "{color.slate.900}"
    },
    "raised": {
      "$value": "{color.slate.800}"
    },
    "sunken": {
      "$value": "{color.slate.950}"
    },
    "inverse": {
      "$value": "{color.slate.50}"
    }
  },
  "mascot": {
    "$type": "color",
    "panel": {
      "$value": "{color.slate.600}",
      "$description": "Soft rounded box behind the mascot. The dark theme uses a lighter tone so the dark question mark of the thinking pose stays legible."
    }
  },
  "fg": {
    "$type": "color",
    "default": {
      "$value": "{color.slate.50}"
    },
    "muted": {
      "$value": "{color.slate.300}"
    },
    "subtle": {
      "$value": "{color.slate.400}"
    },
    "disabled": {
      "$value": "{color.slate.500}"
    },
    "link": {
      "$value": "{color.cyan.400}"
    },
    "accent": {
      "$value": "{color.green.400}"
    },
    "inverse": {
      "$value": "{color.slate.900}"
    }
  },
  "action": {
    "$type": "color",
    "primary": {
      "bg": {
        "$value": "{color.green.400}"
      },
      "bg-hover": {
        "$value": "{color.green.300}"
      },
      "fg": {
        "$value": "{color.slate.900}"
      }
    },
    "danger": {
      "bg": {
        "$value": "{color.red.400}"
      },
      "bg-hover": {
        "$value": "{color.red.300}"
      },
      "fg": {
        "$value": "{color.slate.900}"
      }
    }
  },
  "border": {
    "$type": "color",
    "default": {
      "$value": "{color.slate.800}"
    },
    "control": {
      "$value": "{color.slate.500}"
    }
  },
  "focus": {
    "$type": "color",
    "ring": {
      "$value": "{color.cyan.300}"
    }
  },
  "status": {
    "$type": "color",
    "neutral": {
      "fg": {
        "$value": "{color.slate.300}"
      },
      "bg": {
        "$value": "{color.slate.800}"
      }
    },
    "active": {
      "fg": {
        "$value": "{color.cyan.300}"
      },
      "bg": {
        "$value": "{color.cyan.950}"
      }
    },
    "success": {
      "fg": {
        "$value": "{color.green.300}"
      },
      "bg": {
        "$value": "{color.green.950}"
      }
    },
    "warning": {
      "fg": {
        "$value": "{color.amber.300}"
      },
      "bg": {
        "$value": "{color.amber.950}"
      }
    },
    "danger": {
      "fg": {
        "$value": "{color.red.300}"
      },
      "bg": {
        "$value": "{color.red.950}"
      }
    },
    "attention": {
      "fg": {
        "$value": "{color.violet.300}"
      },
      "bg": {
        "$value": "{color.violet.950}"
      }
    }
  },
  "overlay": {
    "$type": "color",
    "scrim": {
      "$value": "{color.slate.950}",
      "$description": "Dims the page behind a modal dialog or sheet. Used with opacity; decorative."
    }
  },
  "canvas": {
    "$type": "color",
    "bg": {
      "$value": "{color.navy.950}"
    },
    "grid": {
      "$value": "{color.slate.800}"
    },
    "edge": {
      "$value": "{color.slate.400}"
    },
    "port": {
      "$value": "{color.slate.400}"
    },
    "edge-active": {
      "$value": "{brand.green}"
    },
    "selection": {
      "$value": "{brand.green}"
    },
    "node": {
      "border": {
        "$value": "{color.slate.700}"
      },
      "bg": {
        "$value": "{color.slate.900}"
      }
    },
    "marquee": {
      "bg": {
        "$value": "{color.alpha.green-500-15}"
      }
    },
    "sticky": {
      "1": {
        "bg": {
          "$value": "{color.cyan.950}"
        },
        "border": {
          "$value": "{color.cyan.400}"
        },
        "accent": {
          "$value": "{color.cyan.400}"
        }
      },
      "2": {
        "bg": {
          "$value": "{color.green.950}"
        },
        "border": {
          "$value": "{color.green.400}"
        },
        "accent": {
          "$value": "{color.green.400}"
        }
      },
      "3": {
        "bg": {
          "$value": "{color.slate.800}"
        },
        "border": {
          "$value": "{color.slate.400}"
        },
        "accent": {
          "$value": "{color.slate.400}"
        }
      },
      "4": {
        "bg": {
          "$value": "{color.slate.900}"
        },
        "border": {
          "$value": "{color.slate.400}"
        },
        "accent": {
          "$value": "{color.slate.400}"
        }
      },
      "5": {
        "bg": {
          "$value": "{color.cyan.900}"
        },
        "border": {
          "$value": "{color.cyan.300}"
        },
        "accent": {
          "$value": "{color.cyan.300}"
        }
      },
      "6": {
        "bg": {
          "$value": "{color.green.900}"
        },
        "border": {
          "$value": "{color.green.300}"
        },
        "accent": {
          "$value": "{color.green.300}"
        }
      }
    }
  },
  "elevation": {
    "$type": "shadow",
    "sm": {
      "$value": "{shadow.dark.sm}"
    },
    "md": {
      "$value": "{shadow.dark.md}"
    },
    "lg": {
      "$value": "{shadow.dark.lg}"
    }
  }
}
