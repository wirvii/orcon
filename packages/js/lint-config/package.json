{
  "name": "@orcon/lint-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared ESLint and Stylelint configuration for the Orcon web UI.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./eslint.config.mjs",
    "./eslint": "./eslint.config.mjs",
    "./stylelint": "./stylelint.config.mjs"
  },
  "scripts": {
    "lint": "eslint . && stylelint --allow-empty-input \"**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
    "@eslint/js": "^9.0.0",
    "eslint-plugin-better-tailwindcss": "^4.0.0",
    "eslint-plugin-formatjs": "^5.0.0",
    "eslint-plugin-i18next": "^6.1.0",
    "globals": "^16.0.0",
    "stylelint-declaration-strict-value": "^1.10.0",
    "tailwindcss": "^4.1.17",
    "typescript-eslint": "^8.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.20.0",
    "stylelint": "^16.15.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
