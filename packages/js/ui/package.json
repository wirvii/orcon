{
  "name": "@orcon/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Orcon design system: themed, accessible React components built on Radix and the Orcon tokens.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "scripts": {
    "lint": "eslint . && stylelint --allow-empty-input \"**/*.css\"",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/i18n.mjs check",
    "i18n:write": "node scripts/i18n.mjs write",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:stories": "node scripts/check-story-coverage.mjs --strict",
    "test:a11y": "vitest run --project a11y",
    "test:canvas": "vitest run --project canvas --project canvas-motion",
    "test:parity": "vitest run --project parity && node scripts/check-parity-coverage.mjs",
    "test:targets": "vitest run --project targets --project density",
    "test:density": "vitest run --project density",
    "test:expansion": "vitest run --project expansion",
    "test:visual": "pnpm build-storybook && playwright test -c visual/playwright.config.ts",
    "test:visual:docker": "pnpm build-storybook && sh visual/run-docker.sh",
    "test:virtual": "vitest run --project virtual",
    "test:brand": "playwright test -c test/brand/playwright.config.ts",
    "brand:sync": "node scripts/brand-sync.mjs",
    "brand:render": "node scripts/brand-render.mjs",
    "brand:review-shots": "node scripts/brand-review-shots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@orcon/tokens": "workspace:*",
    "@tanstack/react-virtual": "^3",
    "@xyflow/react": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-intl": "^7.1.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@formatjs/cli": "^6.7.0",
    "@formatjs/icu-messageformat-parser": "^2.11.0",
    "@orcon/lint-config": "workspace:*",
    "@playwright/test": "1.64.0",
    "@storybook/addon-a11y": "9.1.20",
    "@storybook/react-vite": "9.1.20",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser-playwright": "^4.1.11",
    "axe-core": "^4.10.0",
    "eslint": "^9.20.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.0",
    "storybook": "9.1.20",
    "storybook-addon-pseudo-states": "9.1.20",
    "stylelint": "^16.15.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  }
}
