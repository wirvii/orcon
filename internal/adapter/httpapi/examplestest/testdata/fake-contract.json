  "paths": {
    "/things/{thingId}": {
      "get": {
        "operationId": "getThing",
        "parameters": [
          {
            "name": "thingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A thing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Thing"
                },
                "examples": {
                  "good": {
                    "value": {
                      "id": "0191f6a2-3c4d-7e8f-9a0b-1c2d3e4f5a60",
                      "name": "Alpha",
                      "createdAt": "2026-10-12T15:04:05Z"
                    }
                  },
                  "wrongValue": {
                    "value": {
                      "id": "0191f6a2-3c4d-7e8f-9a0b-1c2d3e4f5a60",
                      "name": "Zeta",
                      "createdAt": "2026-10-12T15:04:05Z"
                    }
                  }
                }
              }
            }
          }
        },
        "x-orcon-examples": [
          {
            "name": "good",
            "request": {
              "pathParams": {
                "thingId": "0191f6a2-3c4d-7e8f-9a0b-1c2d3e4f5a60"
              }
            },
            "response": {
              "status": 200,
              "body": "good"
            },
            "scenario": "seed-thing"
          },
          {
            "name": "wrongStatus",
            "request": {
              "pathParams": {
                "thingId": "0191f6a2-3c4d-7e8f-9a0b-1c2d3e4f5a60"
              }
            },
            "response": {
              "status": 201,
              "body": "good"
            },
            "scenario": "seed-thing"
          },
          {
            "name": "wrongValue",
            "request": {
              "pathParams": {
                "thingId": "0191f6a2-3c4d-7e8f-9a0b-1c2d3e4f5a60"
              }
            },
            "response": {
              "status": 200,
              "body": "wrongValue"
            },
            "scenario": "seed-thing"
          },
          {
            "name": "unboundId",
            "request": {
              "pathParams": {
                "thingId": "0191f6a2-3c4d-7e8f-9a0b-1c2d3e4f5a61"
              }
            },
            "response": {
              "status": 200,
              "body": "good"
            },
            "scenario": "seed-thing"
          },
          {
            "name": "missingScenario",
            "request": {
              "pathParams": {
                "thingId": "0191f6a2-3c4d-7e8f-9a0b-1c2d3e4f5a60"
              }
            },
            "response": {
              "status": 200,
              "body": "good"
            },
            "scenario": "no-such-scenario"
          }
        ]
      }
    },
    "/things": {
      "post": {
        "operationId": "createThing",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewThing"
              },
              "examples": {
                "createThing": {
                  "value": {
                    "name": "Beta"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Thing"
                },
                "examples": {
                  "createThing": {
                    "value": {
                      "id": "0191f6a2-3c4d-7e8f-9a0b-1c2d3e4f5a62",
                      "name": "Beta",
                      "createdAt": "2026-10-12T15:04:05Z"
                    }
                  }
                }
              }
            }
          }
        },
        "x-orcon-examples": [
          {
            "name": "createThing",
            "request": {
              "body": "createThing"
            },
            "response": {
              "status": 201,
              "body": "createThing"
            }
          }
        ]
      }
    },
    "/things/stream": {
      "get": {
        "operationId": "streamThings",
        "responses": {
          "200": {
            "description": "Event stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "x-orcon-examples": [
          {
            "name": "followThings",
            "request": {},
            "response": {
              "status": 200
            },
            "stream": {
              "trigger": "createThing",
              "expectTypes": [
                "thing.created"
              ],
              "within": "5s"
            }
          }
        ]
      }
    },
    "/broken": {
      "get": {
        "operationId": "getBroken",
        "responses": {
