                "examples": {
                  "badBody": {
                    "value": {
                      "id": "0191f6a2-3c4d-7e8f-9a0b-1c2d3e4f5a60",
                      "name": "Alpha",
                      "createdAt": "2026-10-12T15:04:05Z"
                    }
                  }
                }
              }
            }
          }
        },
        "x-orcon-examples": [
          {
            "name": "badBody",
            "request": {},
            "response": {
              "status": 200,
              "body": "badBody"
            }
          }
        ]
      }
    },
    "/wrapped": {
      "get": {
        "operationId": "getWrapped",
        "responses": {
          "200": {
            "description": "Wrapped in an envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Thing"
                },
                "examples": {
                  "envelope": {
                    "value": {
                      "id": "0191f6a2-3c4d-7e8f-9a0b-1c2d3e4f5a60",
                      "name": "Alpha",
                      "createdAt": "2026-10-12T15:04:05Z"
                    }
                  }
                }
              }
            }
          }
        },
        "x-orcon-examples": [
          {
            "name": "envelope",
