+struct TA_sort_context {
+    JSContext *ctx;
+    int exception;
+    JSValueConst arr;
+    JSValueConst cmp;
+    JSValue (*getfun)(JSContext *ctx, const void *a);
+    int elt_size;
+};
+
+/* Orcon patch: every comparison of the numeric sorts polls the handler (one
+   unit is about the cost of a comparison); after the handler stops the sort the
+   remaining comparisons return at once. */
+#define TA_CMP_POLL(opaque) do { \
+        struct TA_sort_context *psc_ = (opaque); \
+        if (psc_->exception) \
+            return 0; \
+        if (js_poll_work(psc_->ctx, 1)) { \
+            psc_->exception = 1; \
+            return 0; \
+        } \
+    } while (0)
+
 static int js_TA_cmp_int8(const void *a, const void *b, void *opaque) {
+    TA_CMP_POLL(opaque);
     return *(const int8_t *)a - *(const int8_t *)b;
 }
 
 static int js_TA_cmp_uint8(const void *a, const void *b, void *opaque) {
+    TA_CMP_POLL(opaque);
     return *(const uint8_t *)a - *(const uint8_t *)b;
 }
 
 static int js_TA_cmp_int16(const void *a, const void *b, void *opaque) {
+    TA_CMP_POLL(opaque);
     return *(const int16_t *)a - *(const int16_t *)b;
 }
 
 static int js_TA_cmp_uint16(const void *a, const void *b, void *opaque) {
+    TA_CMP_POLL(opaque);
