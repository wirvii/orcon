                  {
                    "id": "r1",
                    "leftValue": "={{ $json.body.text.body }}",
                    "rightValue": "precio",
                    "operator": { "type": "string", "operation": "contains" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Quote"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
