{
  "format": "orcon/flow@1",
  "id": "loop",
  "name": "Loop with a carried variable",
  "settings": { "retention": "FAILED_ONLY" },
  "variables": [
    { "name": "total", "scope": "ITERATION", "carry": true },
    { "name": "pages", "scope": "EXECUTION", "accumulator": "APPEND" }
  ],
  "nodes": [
    { "id": "start", "name": "Start", "element": "startEvent", "type": "orcon.start@1", "parameters": {} },
    {
      "id": "loop",
      "name": "Page loop",
      "element": "exclusiveGateway",
      "type": "orcon.loop@1",
      "parameters": {},
      "loop": { "maxIterations": 50, "carry": ["total"] }
    },
    {
      "id": "page",
      "name": "Fetch page",
      "element": "serviceTask",
      "type": "orcon.http@1",
      "parameters": { "url": "={{ 'https://example.test/items?page=' + $runIndex }}" },
      "writes": ["total", "pages"]
    },
    {
      "id": "more",
      "name": "More pages?",
      "element": "exclusiveGateway",
      "type": "orcon.if@1",
      "parameters": { "condition": "={{ $('Fetch page').item.json.hasMore }}" },
      "routing": "EXCLUSIVE"
    },
    { "id": "end", "name": "End", "element": "endEvent", "type": "orcon.end@1", "parameters": {} }
  ],
  "edges": [
    { "id": "e1", "from": { "node": "start", "port": "main" }, "to": { "node": "loop" }, "kind": "SEQUENCE" },
    { "id": "e2", "from": { "node": "loop", "port": "loop" }, "to": { "node": "page" }, "kind": "SEQUENCE" },
    { "id": "e3", "from": { "node": "page", "port": "main" }, "to": { "node": "more" }, "kind": "SEQUENCE" },
    { "id": "e4", "from": { "node": "more", "port": "true" }, "to": { "node": "loop" }, "kind": "BACK" },
    { "id": "e5", "from": { "node": "more", "port": "false" }, "to": { "node": "end" }, "default": true, "kind": "SEQUENCE" }
  ],
  "editor": {}
}
