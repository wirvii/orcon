{
  "repository": "wirvii/orcon",
  "settings": {
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": false,
    "allow_auto_merge": false,
    "allow_update_branch": true,
    "delete_branch_on_merge": true,
    "squash_merge_commit_title": "PR_TITLE",
    "squash_merge_commit_message": "BLANK"
  },
  "security_and_analysis": {
    "secret_scanning": "enabled",
    "secret_scanning_push_protection": "enabled"
  },
  "private_vulnerability_reporting": true,
  "dependabot_alerts": true,
  "actions_workflow_permissions": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "fork_pr_approval_policy": "all_external_contributors",
  "rulesets": {
    "main": {
      "target": "branch",
      "enforcement": "active",
      "include": ["~DEFAULT_BRANCH"],
      "bypass_actors": [],
      "rules": ["deletion", "non_fast_forward", "required_linear_history", "pull_request", "required_status_checks"],
      "pull_request": {
        "required_approving_review_count": 0,
        "required_approving_review_count_with_codeowners": 1,
        "dismiss_stale_reviews_on_push": true,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["squash"]
      },
      "required_status_checks": {
        "strict": true,
        "integration_id": 15368,
        "checks": [
          { "context": "commit-lint", "workflow": "pr.yml", "job": "commit-lint" },
          { "context": "release-check", "workflow": "contributing.yml", "job": "release-check" },
          { "context": "integration", "workflow": "ci.yml", "job": "integration" },
          { "context": "ui-quality", "workflow": "ci.yml", "job": "ui-quality" },
          { "context": "ui-visual", "workflow": "ci.yml", "job": "ui-visual" },
          { "context": "skills", "workflow": "ci.yml", "job": "skills" },
          { "context": "check (go oldstable)", "workflow": "ci.yml", "job": "check" },
          { "context": "check (go stable)", "workflow": "ci.yml", "job": "check" },
          { "context": "provenance", "workflow": "ci.yml", "job": "provenance" },
          { "context": "postgres", "workflow": "ci.yml", "job": "postgres" },
          { "context": "web-e2e", "workflow": "ci.yml", "job": "web-e2e" },
          { "context": "web-perf", "workflow": "ci.yml", "job": "web-perf" },
          { "context": "connectors", "workflow": "ci.yml", "job": "connectors" },
          { "context": "api-contract", "workflow": "ci.yml", "job": "api-contract" }
        ]
      }
    },
    "release-tags": {
      "target": "tag",
      "enforcement": "active",
      "include": ["refs/tags/v*"],
      "bypass_actors": [{ "actor_type": "Integration", "app_slug": "orcon-release" }],
      "rules": ["creation", "update", "deletion", "non_fast_forward"]
    }
  }
}
